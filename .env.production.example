# ==============================================================================
# متغيرات البيئة الخاصة بالإنتاج - شجرة عائلة النمري (معزولة بالكامل)
# انسخ هذا الملف إلى .env.production أو .env.local على السيرفر
# ==============================================================================

# منفذ التطبيق (3001 لمنع أي تعارض مع مشروع أبو فاره العامل على 3000)
PORT=3001
NODE_ENV=production

# رابط قاعدة البيانات المخصصة لعائلة النمري
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/family_tree_nammari_db

# إعدادات Supabase (الخاصة بمشروع النمري)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# مفاتيح البريد الإلكتروني
RESEND_API_KEY=your_resend_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
