# إعداد Nginx المخصص لمشروع عائلة النمري (معزول تماماً عن مشروع عائلة أبو فاره)
# ضع هذا الملف في: /etc/nginx/sites-available/nammari-tree
# ثم قم بتفعيله: ln -s /etc/nginx/sites-available/nammari-tree /etc/nginx/sites-enabled/

server {
    listen 80;
    # استبدل بالدومين الفرعي الخاص بك
    server_name nammari.yourdomain.com;

    client_max_body_size 20M;

    location / {
        # يوجه حصرياً إلى المنفذ 3001 المخصص لمشروع النمري
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # مسار خاص لتحسين تحميل الملفات الثابتة
    location /_next/static {
        proxy_pass http://127.0.0.1:3001;
        proxy_cache_valid 200 60m;
        proxy_set_header Host $host;
    }
}
